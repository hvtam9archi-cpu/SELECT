<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>SELECT</AssemblyName>
    <RootNamespace>UnifiedAutoCADTools</RootNamespace>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="DeployBundle" AfterTargets="Build">
    <MakeDir Directories="$(AppData)\Autodesk\ApplicationPlugins\SELECT.bundle\Contents" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\SELECT.bundle\Contents" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\SELECT.bundle\Contents" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)Installer\PackageContents.xml" DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\SELECT.bundle" SkipUnchangedFiles="false" />
  </Target>
</Project>